<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>OPEN FDA SEARCH PAGE</title>
    <style>
body {
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  background-color: #f8fafc;
  color: #1e293b;
  margin: 0;
  padding: 20px;
}

.container {
  max-width: 700px;
  margin: 40px auto;
  background: white;
  padding: 32px;
  border-radius: 8px;
  box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
}

.search-form {
  display: flex;
  gap: 10px;
  margin-top: 20px;
}

input[type="text"] {
  flex: 1;
  padding: 12px;
  border: 1px solid #cbd5e1;
  border-radius: 4px;
  font-size: 16px;
}

button {
  background-color: #2563eb;
  color: white;
  border: none;
  padding: 12px 20px;
  border-radius: 4px;
  cursor: pointer;
  font-size: 16px;
}
    </style>
</head>
    <body>
  <main class="container">
    <h1>FDA Drug Safety Lookup</h1>
    <p>Search official FDA medication labels for warnings and safety data.</p>

    <% if (locals.error) { %>
      <div class="alert alert-error">
        <%= error %>
      </div>
    <% } %>

    <form action="http://localhost:5000/api/auth/open-fda/result" method="get" class="search-form">
      <input 
        type="text" 
        name="item" 
        placeholder="Enter medication name (e.g., Lipitor, Ibuprofen)" 
        required 
      />
      <button type="submit">Search Safety Label</button>
    </form>
  </main>
</body>
</html>