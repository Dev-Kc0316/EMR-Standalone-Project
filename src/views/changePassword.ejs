<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Change Password form</title>
    <link rel="stylesheet" href="style.css" />
    <style>
      @import url("https://fonts.googleapis.com/css2?family=Roboto+Mono&display=swap");

      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      body {
        font-family: "Roboto Mono", monospace;
        background-color: whitesmoke;
        display: flex;
        justify-content: center;
        align-items: center;
        height: 100vh;
        padding: 0 32px;
      }

      .register-container {
        background-color: white;
        border-radius: 15px;
        padding: 32px 48px;
        width: 400px;
        color: #333;
        box-shadow: 0 0 20px rgba(0, 0, 255, 0.1);
      }

      .register-container h2 {
        text-align: center;
        color: #1b4ef5;
        font-size: 25px;
        margin-bottom: 32px;
        padding: 10px;
        border-radius: 12px;
      }

      .register-container label {
        display: block;
        margin-bottom: 8px;
        font-size: 17px;
        color: #1b4ef5;
      }

      .register-container input[type="email"],
      .register-container input[type="text"],
      .register-container input[type="password"] {
        background-color: #ffffffeb;
        width: 100%;
        padding: 8px;
        font-size: 17.6px;
        border-radius: 12px;
        border: 2px solid #1b4ef5;
        color: #1b4ef5;
        margin-bottom: 24px;
      }

      .register-container button.submit-button {
        background-color: #1b4ef5;
        width: 100%;
        margin-top: 20px;
        padding: 12px;
        font-size: 20px;
        color: white;
        border: none;
        border-radius: 12px;
        cursor: pointer;
        transition:
          background-color 0.3s ease,
          transform 0.1s ease;
      }

      .register-container button.submit-button:hover {
        background-color: #5996ff;
      }

      .register-container button.submit-button:active {
        background-color: #3874ff;
        transform: scale(0.98);
      }

      .error-box {
        background: #ffe6e6;
        color: #cc0000;
        padding: 10px;
        border: 1px solid #cc0000;
        border-radius: 8px;
        margin-bottom: 15px;
      }

      .error-text {
        color: #cc0000;
        font-size: 0.85em;
        display: block;
        margin-top: -18px;
        margin-bottom: 18px;
      }
    </style>
  </head>

  <body>
    <div class="register-container">
      <h2>Change Password</h2>

      <% if (locals.errors && errors.length > 0) { %>
        <div class="error-box">
          <strong>Please fix the errors below:</strong>
          <ul>
            <% errors.forEach(function(err) { %>
              <li><%= err.msg %></li>
            <% }) %>
          </ul>
        </div>
      <% } %>

      <form id="register-form" action="http://localhost:5000/api/auth/change-password/<%= locals.token %>" method="post">
        <label for="email-input">Email:</label>
        <input 
          type="email" 
          id="email-input" 
          name="email" 
          value="<%= (locals.previous && previous.email) ? previous.email : '' %>" 
        />
        <% const emailErr = locals.errors && errors.find(e => e.path === 'email') %>
        <% if (emailErr) { %>
          <span class="error-text"><%= emailErr.msg %></span>
        <% } %>

        <label for="password-input">Password:</label>
        <input type="password" id="password-input" name="password" />
        <% const passErr = locals.errors && errors.find(e => e.path === 'password') %>
        <% if (passErr) { %>
          <span class="error-text"><%= passErr.msg %></span>
        <% } %>

        <label for="password-confirm-input">Confirm password:</label>
        <input
          type="password"
          id="password-confirm-input"
          name="password_confirm"
        />
        <% const confirmErr = locals.errors && errors.find(e => e.path === 'password_confirm') %>
        <% if (confirmErr) { %>
          <span class="error-text"><%= confirmErr.msg %></span>
        <% } %>

        <button class="submit-button" type="submit">Submit</button>
      </form>
    </div>
  </body>
</html>